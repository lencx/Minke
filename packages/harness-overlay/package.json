{
  "name": "@lencx/minke-harness-overlay",
  "description": "Minke-owned DeepSeek Harness product extensions",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.client.json --noEmit && node ../../vendor/deepseek-harness/node_modules/typescript/bin/tsc -b tsconfig.host.json --pretty false"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@lencx/minke-model-runtime": "workspace:*",
    "@lencx/minke-remote-access": "workspace:*",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@iconify-json/vscode-icons": "1.2.73",
    "@lucide/icons": "1.31.0",
    "@types/qrcode": "1.5.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "shiki": "4.4.3"
  }
}
