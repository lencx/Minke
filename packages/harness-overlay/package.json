{
  "name": "@lencx/minke-harness-overlay",
  "description": "Minke-owned DeepSeek Harness product extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.client.json --noEmit && node ../../vendor/deepseek-harness/node_modules/typescript/bin/tsc -b tsconfig.host.json --pretty false"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./model-runtime": "./lib/model-runtime.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "devDependencies": {
    "@lucide/icons": "1.31.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
